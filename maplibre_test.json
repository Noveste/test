{
  "version": 8,
  "name": "GPX Studio - Surface Inspector",
  "metadata": {
    "description": "Style highlighting specific road surface values using named CSS colors."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "whitesmoke"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "lightblue"
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!=", "class", "railway"],
        ["!=", "class", "ferry"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "white",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 1.5,
          14, 5,
          18, 12
        ]
      }
    },
    {
      "id": "road-surface",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!=", "class", "railway"],
        ["!=", "class", "ferry"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 0.8,
          14, 3.5,
          18, 9
        ],
        "line-color": [
          "match",
          ["get", "surface"],
          ["asphalt", "concrete"],
          "darkgray",
          ["dirt", "earth", "ground"],
          "saddlebrown",
          "mud",
          "brown",
          "sand",
          "yellow",
          ["gravel", "fine_gravel"],
          "gray",
          "lightgray"
        ]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-size": 11,
        "text-font": ["Noto Sans Regular"]
      },
      "paint": {
        "text-color": "black",
        "text-halo-color": "white",
        "text-halo-width": 1.5
      }
    }
  ]
}
